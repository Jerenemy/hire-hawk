# Copy to /etc/spencer-jobs.env. Use a Gmail APP password, not your account password.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=replace_with_app_password
EMAIL_TO=you@gmail.com
DATABASE_PATH=/var/lib/spencer-jobs/jobs.sqlite3
# SEARCH_URL is optional. The exact supplied search is built in.
# To monitor a different search, also choose a NEW database path.
